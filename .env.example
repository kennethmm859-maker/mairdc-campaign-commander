# Administrator access gate (required in production)
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Required for production persistence
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require

# Public production base URL used to construct OAuth callbacks.
# Example: https://mairdc-campaign-commander.vercel.app
APP_BASE_URL=

# Generate 32 random bytes and store as 64 hex characters.
TOKEN_ENCRYPTION_KEY=

# Protect scheduler calls. Vercel automatically sends CRON_SECRET as Bearer auth when configured.
CRON_SECRET=

# Platform credentials (add only after the corresponding developer app is approved)
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SNAP_CLIENT_ID=
SNAP_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
